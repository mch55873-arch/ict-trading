//@version=6
// MODULE 1: Types, Enums & Core Utilities
// Repository: github.com/mch55873-arch/ict-trading

int FSM_IDLE         = 0
int FSM_SWEEP        = 1
int FSM_DISPLACEMENT = 2
int FSM_FVG          = 3
int FSM_MSS          = 4
int FSM_OB_ACTIVE    = 5
int FSM_RETRACE      = 6
int FSM_EXECUTION    = 7

int DIR_NONE  = 0
int DIR_LONG  = 1
int DIR_SHORT = -1

type FvgZone
    box   b
    bool  isBull
    bool  isInverted
    bool  isRetested
    int   createdBar

type ObZone
    box   b
    bool  isBull
    int   barIdx
    float top
    float bot
    float meanThreshold
    int   stage // 0: Fresh, 1: Partial, 2: Full 50%, 3: Breaker, 4: Invalidated

type Trade
    int   direction
    float entryPrice
    float slPrice
    float partialTpPrice
    float finalTpPrice
    int   entryBar
    bool  active
    bool  partialTaken
    bool  isBreakEven
    string status

f_trimBoxes(arr, mx) =>
    while array.size(arr) > mx
        box.delete(array.shift(arr))

f_getFsmStateName(st) =>
    st == 0 ? "IDLE" : st == 1 ? "SWEEP" : st == 2 ? "DISPLACEMENT" : st == 3 ? "FVG_QUALIFIED" : st == 4 ? "MSS_SHIFT" : st == 5 ? "OB_ACTIVE" : st == 6 ? "RETRACE" : st == 7 ? "EXECUTION" : "UNKNOWN"
